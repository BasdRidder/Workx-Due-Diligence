# Database (wordt automatisch gezet als je Neon via Vercel Storage koppelt)
DATABASE_URL=

# Inloggen (staat uit zolang LOGIN_ENABLED niet op true staat)
LOGIN_ENABLED=
# AUTH_SECRET: lange willekeurige tekst, bijvoorbeeld van  openssl rand -base64 32
AUTH_SECRET=
# Eerste beheerder. Werkt alleen zolang er nog geen accounts zijn; bij de eerste login kies je een eigen wachtwoord.
ADMIN_EMAIL=
# Minstens 12 tekens. Na de eerste login mag je deze instelling weer verwijderen.
ADMIN_PASSWORD=

# Claude-hulp (optioneel)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium

# Alleen lokaal ontwikkelen: inloggen overslaan (werkt nooit in productie)
# AUTH_DISABLED=true
