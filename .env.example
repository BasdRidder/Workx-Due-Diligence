# Database (wordt automatisch gezet als je Neon via Vercel Storage koppelt)
DATABASE_URL=

# Inloggen (Auth.js + Microsoft Entra ID)
# AUTH_SECRET: genereer met  openssl rand -base64 32
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# https://login.microsoftonline.com/<TENANT-ID>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
# Alleen accounts met dit e-maildomein mogen inloggen (komma-gescheiden)
ALLOWED_EMAIL_DOMAINS=workxadvocaten.nl

# Claude-hulp (optioneel)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium

# Alleen lokaal ontwikkelen: inloggen overslaan (werkt nooit in productie)
# AUTH_DISABLED=true
